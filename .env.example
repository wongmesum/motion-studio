# ============================================================
# MOTION STUDIO — ENVIRONMENT CONFIGURATION
# ChatGPT MCP + Higgsfield AI + DeepSeek Engineer + VPS Render
# ============================================================

# ====== 1. HIGGSFIELD AI (Asset Generator) ======
HIGGSFIELD_API_URL=https://api.higgsfield.ai
HIGGSFIELD_API_KEY=your_higgsfield_api_key_here
HIGGSFIELD_DEFAULT_MODEL=soul

# ====== 2. VPS RENDER SERVER ======
PORT=3000
VPS_ENDPOINT=http://localhost:3000
VPS_PUBLIC_URL=http://localhost:3000
# Leave blank for secure random runtime generation, or set explicit values in deployment secret store.
VPS_TOKEN=
ADMIN_TOKEN=
HMAC_SECRET=
REQUIRE_HMAC_SIGNATURE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ====== 3. AI RENDER ENGINEER (5-Stage Gate) ======
DEEPSEEK_ENABLED=true
# Active provider for the engineer pipeline, MCP client, and admin test route.
# Allowed values: river | deepseek. No automatic fallback between providers.
AI_PROVIDER=river

# --- Provider A: River AI gateway (https://console.river.ai/keys) ---
RIVER_API_BASE_URL=https://api.river.ai
RIVER_API_KEY=
RIVER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
RIVER_STREAM=true
RIVER_TEMPERATURE=0.7
RIVER_MAX_TOKENS=2048
DEEPSEEK_MAX_FIX_ATTEMPTS=3

# --- Provider B: DeepSeek Official ---
# Docs: https://api-docs.deepseek.com/  — API base is https://api.deepseek.com (no /v1 suffix needed).
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Explicit HTTPS allowlist for browser requests and asset downloads (exact hostnames only).
RENDER_ALLOWED_HOSTS=cdn.jsdelivr.net,cdnjs.cloudflare.com,unpkg.com
# Optional local file roots for Playwright, separated by OS path delimiter (; on Windows, : on Linux).
RENDER_ALLOWED_FILE_DIRS=

# MCP client sends X-Token for auth and signs body with separate HMAC_SECRET.

# ====== 4. REDIS (BullMQ Distributed Queue & Cache) ======
# Jika REDIS_ENABLED=false, sistem otomatis memakai In-Memory Queue
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ====== 5. MINIO / S3 STORAGE (Asset & Output CDN) ======
# Jika MINIO_ENABLED=false, file disimpan di folder ./output dan ./cache lokal
MINIO_ENABLED=true
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=motion-assets
MINIO_SIGNED_URL_EXPIRY=86400

# ====== 6. RENDER ENGINE CONFIG (1080p @ 60fps) ======
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
RENDER_FPS=60
RENDER_DURATION=10
RENDER_CODEC=h264
RENDER_CRF=18
RENDER_PRESET=slow
RENDER_FRAME_FORMAT=jpeg
RENDER_JPEG_QUALITY=95
RENDER_PARALLEL=0
KEEP_FRAMES=false

# ====== 7. SECURITY, LIMITS & CLEANUP ======
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
MAX_JOB_DURATION_SEC=60
MAX_JOB_FPS=120
MAX_HTML_BYTES=500000
MAX_ASSETS_COUNT=20
MAX_AUDIO_BYTES=26214400
MAX_AUDIO_DOWNLOAD_MS=60000
JOB_TIMEOUT_MS=600000
CLEANUP_TTL_HOURS=24

# ====== 8. WEBHOOK / CALLBACK ======
WEBHOOK_URL=
WEBHOOK_SECRET=
