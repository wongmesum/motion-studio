{
  "name": "motion-studio",
  "version": "1.0.0",
  "description": "Production-grade Motion Graphics Pipeline: ChatGPT MCP + Higgsfield AI + DeepSeek Engineer + VPS Render Farm (Playwright, Canvas 2D, GSAP via CDN, Sharp, FFmpeg)",
  "type": "module",
  "scripts": {
    "render": "node render.js",
    "render:kinetic": "node render.js --template render-engine/templates/kinetic-text.html --output output/kinetic-promo.mp4",
    "render:slideshow": "node render.js --template render-engine/templates/image-slideshow.html --output output/slideshow.mp4",
    "render:mixer": "node render.js --template render-engine/templates/video-mixer.html --output output/video-mixer.mp4",
    "start:server": "node vps-server/server.js",
    "start:worker": "node vps-server/workers/worker.js",
    "start:mcp": "node mcp-server/index.js",
    "verify": "bash scripts/verify-stack.sh",
    "zip": "bash build.sh",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.7",
    "bullmq": "^5.15.0",
    "busboy": "^1.6.0",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "playwright": "1.64.1",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
