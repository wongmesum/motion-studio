{
  "name": "motion-studio",
  "version": "1.0.0",
  "description": "Production-grade Motion Graphics Pipeline: ChatGPT MCP + Higgsfield AI + DeepSeek Engineer + VPS Render Farm (Playwright, Remotion, GSAP, Three.js, Sharp, FFmpeg)",
  "type": "module",
  "scripts": {
    "render": "node render.js",
    "render:kinetic": "node render.js --template render-engine/templates/kinetic-text.html --output output/kinetic-promo.mp4",
    "render:slideshow": "node render.js --template render-engine/templates/image-slideshow.html --output output/slideshow.mp4",
    "render:mixer": "node render.js --template render-engine/templates/video-mixer.html --output output/video-mixer.mp4",
    "start:server": "node vps-server/server.js",
    "start:worker": "node vps-server/workers/worker.js",
    "start:mcp": "node mcp-server/index.js",
    "verify": "bash scripts/verify-stack.sh",
    "zip": "bash build.sh",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.7",
    "bullmq": "^5.15.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "form-data": "^4.0.0",
    "gsap": "^3.12.5",
    "ioredis": "^5.4.1",
    "lottie-web": "^5.12.2",
    "minio": "^8.0.1",
    "node-cron": "^3.0.3",
    "p-limit": "^6.1.0",
    "pino": "^9.4.0",
    "playwright": "^1.48.0",
    "sharp": "^0.33.5",
    "three": "^0.169.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
